  n4 [label="C0-y-x-x  (depth=3)\lblow-up 中心 \{x, y = 0\}, chart x: y -\> x^1*y\lblow-up 後: x**3*y**2*z**4 + x*y + x\l単項式 x を括り出し\l正規化後: x**2*y**2*z**4 + y + 1\lk=(6, 2, 0)  h=(6, 2, 0)\l[枝刈り] LB=7/6 \> 1.083\l", fillcolor="#e6e6e6"];
  n5 [label="C0-y-x-y  (depth=3)\lblow-up 中心 \{x, y = 0\}, chart y: x -\> y^1*x\lblow-up 後: x*y**3*z**4 + x*y + y\l単項式 y を括り出し\l正規化後: x*y**2*z**4 + x + 1\lk=(3, 6, 0)  h=(3, 6, 0)\l[枝刈り] LB=7/6 \> 1.083\l", fillcolor="#e6e6e6"];
